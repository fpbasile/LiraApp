  },
  "onboarding-r0-t": {
   "x": 0,
   "y": -300,
   "text": "Onboarding — two questions, then you log for real",
   "kind": "title1",
   "maxW": 2380,
   "page": "onboarding"
  },
  "onboarding-r0-s": {
   "x": 2460,
   "y": 0,
   "text": "No feature tour. After sign-up Lira asks two things — home currency and a daily limit — then drops you on the real Home with one coach card: you learn by logging.\n\nThe currency is pre-filled from your region (one tap); the limit can be skipped.",
   "w": 380,
   "size": "m",
   "fill": "gray",
   "page": "onboarding"
  }

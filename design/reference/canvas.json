  },
  "brand-r0-t": {
   "x": 0,
   "y": -300,
   "text": "Logo & app icon",
   "kind": "title1",
   "maxW": 1440,
   "page": "brand"
  },
  "core-r0-t": {
   "x": 0,
   "y": -300,
   "text": "Home = quick add",
   "kind": "title1",
   "maxW": 2872,
   "page": "core"
  },
  "core-r0-s": {
   "x": 2952,
   "y": 0,
   "text": "The first board is a working prototype — press Play and log something: type an amount, tap a category, undo, flip to Income, or keep spending to see the over-limit state.\n\nAmount first → tapping a category saves instantly. Category first → the chip stays selected and ✓ saves.",
   "w": 380,
   "size": "m",
   "fill": "gray",
   "page": "core"
  },
  "core-r1-t": {
   "x": 0,
   "y": 1055,
   "text": "The save moment",
   "kind": "title1",
   "maxW": 2340,
   "page": "core"
  },
  "core-r1-s": {
   "x": 2420,
   "y": 1355,
   "text": "Nothing waits to be dismissed: the keypad is clear at 60 ms and the first keypress hides the undo bar.\n\nOver the limit is the only place red appears — with words, and with the week still in view.",
   "w": 380,
   "size": "m",
   "fill": "gray",
   "page": "core"
  },
  "core-r2-t": {
   "x": 0,
   "y": 2692,
   "text": "Scan a receipt",
   "kind": "title1",
   "maxW": 1200,
   "page": "core"
  },
  "core-r2-s": {
   "x": 984,
   "y": 2992,
   "text": "Scan sits next to Save on the keypad. After the photo, you land on the same quick-add screen, pre-filled — review, correct with the keypad, save.",
   "w": 380,
   "size": "m",
   "fill": "gray",
   "page": "core"
  },
  "core-r3-t": {
   "x": 0,
   "y": 4047,
   "text": "Today, weekly recap & Insights",
   "kind": "title1",
   "maxW": 1396,
   "page": "core"
  },
  "core-r3-s": {
   "x": 1476,
   "y": 4347,
   "text": "Insights replaces Calendar + Stats: written insights first, then the month calendar, trend, categories and weekdays.\n\nThe recap card shows once on Monday and tucks into Insights at the first keypress.",
   "w": 380,
   "size": "m",
   "fill": "gray",
   "page": "core"
  },
  "core-r4-t": {
   "x": 0,
   "y": 7547,
   "text": "Travel mode",
   "kind": "title1",
   "maxW": 1396,
   "page": "core"
  },
  "core-r4-s": {
   "x": 1476,
   "y": 7847,
   "text": "Navigation: three tabs — Home · Insights · More. Travel is a mode, not a tab: start it from the currency chip (or More › Trips); while it runs, Home shows the trip banner, which opens the trip view.",
   "w": 380,
   "size": "m",
   "fill": "gray",
   "page": "core"
  },
  "core-r5-t": {
   "x": 0,
   "y": 9387,
   "text": "Home screen widget",
   "kind": "title1",
   "maxW": 1320,
   "page": "core"
  },
  "secondary-r0-t": {
   "x": 0,
   "y": -300,
   "text": "Account & settings",
   "kind": "title1",
   "maxW": 2380,
   "page": "secondary"
  },
  "secondary-r0-s": {
   "x": 2460,
   "y": 0,
   "text": "Every money input — recurring, edit, converter — reuses quick-add: amount on top, chips in the middle, keypad at the bottom.",
